---
/**
 * FAQ list. Renders as a no-JS `<details>` accordion by default; pass
 * `accordion={false}` for an always-expanded list.
 *
 * Set `emitJsonLd` to also output FAQPage structured data, which Google can use
 * for rich results. The script tag is emitted inline because a child component
 * cannot inject into an ancestor's <head>.
 */
import '../styles/theme.css';
import type { FaqItem } from './types';

interface Props {
    id?: string;
    title: string;
    subtitle?: string;
    items: FaqItem[];
    accordion?: boolean;
    emitJsonLd?: boolean;
}

const { id, title, subtitle, items, accordion = true, emitJsonLd = false } = Astro.props;

const schema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: items.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
};
---

<section class="faq" id={id}>
    <div class="container">
        <div class="section-header">
            <h2>{title}</h2>
            {subtitle && <p>{subtitle}</p>}
        </div>

        <div class="faq-list">
            {
                items.map((item) =>
                    accordion ? (
                        <details class="faq-item">
                            <summary>{item.q}</summary>
                            <p>{item.a}</p>
                        </details>
                    ) : (
                        <div class="faq-item">
                            <h3>{item.q}</h3>
                            <p>{item.a}</p>
                        </div>
                    ),
                )
            }
        </div>

        {emitJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
    </div>
</section>

<style>
    .faq {
        padding: var(--section-padding) 0;
        background: var(--bg-page);
    }

    .faq-list {
        max-width: 800px;
        margin: 0 auto;
    }

    .faq-item {
        padding: 24px 0;
        border-bottom: 1px solid var(--border-subtle);
    }

    .faq-item:first-child {
        border-top: 1px solid var(--border-subtle);
    }

    h3 {
        margin-bottom: 8px;
        color: var(--color-dark);
        font-size: 18px;
    }

    p {
        color: var(--text-body);
        font-size: 15px;
    }

    /* Accordion mode */
    summary {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        color: var(--color-dark);
        font-size: 18px;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.3;
        cursor: pointer;
        list-style: none;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary::after {
        flex-shrink: 0;
        color: var(--color-primary);
        font-size: 22px;
        font-weight: 400;
        line-height: 1.1;
        content: '+';
        transition: transform 0.2s ease;
    }

    details[open] summary::after {
        transform: rotate(45deg);
    }

    details[open] summary {
        margin-bottom: 12px;
    }

    details p {
        padding-right: 40px;
    }

    @media (max-width: 868px) {
        details p {
            padding-right: 0;
        }
    }
</style>