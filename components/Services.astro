---
/**
 * Feature grid: evenly spaced cards, each with an optional icon, heading, and body copy.
 */
import '../styles/theme.css';
import Icon from './Icon.astro';
import { hasIcon } from './icons/registry';
import type { FeatureItem } from './types';

interface Props {
    id?: string;
    title: string;
    subtitle?: string;
    items: FeatureItem[];
    /** Card count per row on desktop. */
    columns?: 2 | 3 | 4;
    tone?: 'white' | 'muted';
}

const { id, title, subtitle, items, columns = 3, tone = 'white' } = Astro.props;
---

<section class="services" id={id} data-tone={tone}>
    <div class="container">
        <div class="section-header">
            <h2>{title}</h2>
            {subtitle && <p>{subtitle}</p>}
        </div>

        <div class="services-grid" style={`--cols: ${columns}`}>
            {
                items.map((item) => (
                    <div class="service-card">
                        {item.icon && (
                            <div class="service-icon">
                                {hasIcon(item.icon) ? (
                                    <Icon name={item.icon} size={24} />
                                ) : (
                                    <span class="service-icon-text">{item.icon}</span>
                                )}
                            </div>
                        )}
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .services {
        padding: var(--section-padding) 0;
        background: var(--bg-surface);
    }

    .services[data-tone='muted'] {
        background: var(--bg-page);
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(var(--cols, 3), 1fr);
        gap: 32px;
    }

    .service-card {
        padding: 36px;
        background: var(--bg-page);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }

    .service-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-card);
    }

    .service-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        margin-bottom: 20px;
        background: var(--gradient-brand);
        border-radius: var(--radius-md);
        color: var(--bg-surface);
        font-size: 20px;
        font-weight: 800;
    }

    .service-card h3 {
        margin-bottom: 12px;
        font-size: 20px;
    }

    .service-card p {
        color: var(--text-body);
        font-size: 15px;
    }

    @media (max-width: 868px) {
        .services-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }
    }
</style>