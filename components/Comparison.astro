---
/**
 * Two-column comparison, e.g. "old way vs your way".
 *
 * Fully brand-agnostic: tone drives the color treatment, so there is no baked-in
 * competitor name or company name to strip out before reusing.
 */
import '../styles/theme.css';
import Icon from './Icon.astro';
import type { ComparisonSide } from './types';

interface Props {
    id?: string;
    title: string;
    subtitle?: string;
    left: ComparisonSide;
    right: ComparisonSide;
}

const { id, title, subtitle, left, right } = Astro.props;

const sides = [
    { side: left, marker: 'x' },
    { side: right, marker: 'check' },
];
---

<section class="comparison" id={id}>
    <div class="container">
        <div class="section-header">
            <h2>{title}</h2>
            {subtitle && <p>{subtitle}</p>}
        </div>

        <div class="comparison-grid">
            {
                sides.map(({ side, marker }) => (
                    <div class="comparison-card" data-tone={side.tone} data-highlight={side.highlight ?? side.tone === 'positive' ? '' : undefined}>
                        <h3 class="gradient-text">{side.heading}</h3>
                        <ul>
                            {side.items.map((item) => (
                                <li>
                                    <Icon name={marker} size={16} strokeWidth={3} />
                                    <span>{item}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .comparison {
        padding: var(--section-padding) 0;
        background: var(--bg-page);
    }

    .comparison-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
    }

    .comparison-card {
        padding: 40px;
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-xl);
    }

    .comparison-card[data-tone='negative'] {
        background: var(--tone-negative-surface);
        border-color: var(--tone-negative-border);
    }

    .comparison-card[data-tone='positive'] {
        background: var(--bg-surface);
        border-color: var(--tone-positive-border);
    }

    .comparison-card[data-tone='positive'][data-highlight] {
        box-shadow: var(--shadow-card);
        position: relative;
    }

    .comparison-card h3 {
        margin-bottom: 20px;
        font-size: 24px;
    }

    .comparison-card ul {
        list-style: none;
    }

    .comparison-card li {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 12px 0;
        font-size: 15px;
        font-weight: 600;
    }

    .comparison-card[data-tone='negative'] li {
        color: var(--tone-negative-text);
    }

    .comparison-card[data-tone='positive'] li {
        color: var(--tone-positive-text);
    }

    .comparison-card svg {
        flex-shrink: 0;
        margin-top: 5px;
    }

    @media (max-width: 868px) {
        .comparison-card {
            padding: 24px;
        }

        .comparison-card h3 {
            font-size: 20px;
        }

        .comparison-card li {
            gap: 8px;
            padding: 8px 0;
            font-size: 14px;
        }
    }
</style>